# Copy to /etc/panel-club.env on the VPS (chmod 600). Fill values by hand; do not commit secrets.
# DATABASE_URL must be the Neon direct (non-pooler) connection string — pooler hosts can stall long ingest work.
DATABASE_URL=
YOUTUBE_API_KEY=
# Optional ping URL for ingest job success/failure (Healthchecks.io).
HEALTHCHECKS_URL=
