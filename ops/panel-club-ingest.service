[Unit]
Description=Panel Club YouTube catalog ingest (Docker / Neon)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/panel-club.env
ExecStart=/bin/sh -c '/usr/bin/docker pull ghcr.io/laraib-labs/panel-club-ingest:latest && /usr/bin/docker run --rm --env-file /etc/panel-club.env ghcr.io/laraib-labs/panel-club-ingest:latest'

[Install]
WantedBy=multi-user.target
